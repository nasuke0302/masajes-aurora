# Public origin. Use http://localhost:3000 for local development.
SITE_URL=http://localhost:3000
ANIMATED_MARBLE=false
# Local link-login recipient / booking notification recipient, and Resend email sender. Never use invented values for production.
ADMIN_EMAIL=masajesaurora@gmail.com
EMAIL_FROM=
# Resend server-only sending key; deployed only to the email Worker.
RESEND_API_KEY=
# Separate D1 database and queue per environment.
D1_DATABASE_ID=
# Optional custom hostname in a Cloudflare zone belonging to the authenticated account.
WORKER_DOMAIN=
NOTIFICATIONS_QUEUE=masajes-aurora-notifications-staging
# Use a restricted Stripe key with Checkout, Events, PaymentIntents and Refunds permissions.
# Secrets stay in the server environment; upload with cf Workers secrets commands.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Dashboard configuration permitting only immediate payment methods (e.g. card and wallets).
STRIPE_PAYMENT_CONFIGURATION=
# Set only after staging tests. npm run deploy -- --production
DEPLOY_PRODUCTION=false

# Turnstile sitekey is public; secret is server-only, deployed only to the web Worker.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
