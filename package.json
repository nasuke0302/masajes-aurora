    "@cloudflare/workers-types": "latest",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.4",
    "cf": "1.0.0-beta.14",
    "esbuild": "^0.28.1",
    "miniflare": "5.20261006.1-alpha",
    "tailwindcss": "^4.3.3",
